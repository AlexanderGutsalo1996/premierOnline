# Target environment (default = https://www.premieronline.com)
BASE_URL=
# Local workers (CI always uses 1)
WORKERS=2
LOG_LEVEL=INFO
# Set to 1 to skip auto-opening the Allure report after local runs
NO_REPORT_OPEN=
# Real account for the positive login test (local: .env.local, CI: GitHub Secrets)
LOGIN_EMAIL=
LOGIN_PASSWORD=
# WordPress API tests (CI: GitHub Secrets)
WP_USERNAME=
WP_APP_PASSWORD=
# Slack Incoming Webhook (local optional; CI uses the GitHub Secret)
SLACK_WEBHOOK_URL=
